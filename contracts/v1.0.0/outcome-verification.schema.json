{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.viridianai.in/promiseops/v1.0.0/outcome-verification.schema.json",
  "title": "Vantix Control Value Outcome Verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "verificationId",
    "correlationId",
    "promiseId",
    "accountKey",
    "evaluatedAt",
    "syntheticData",
    "rulesetVersion",
    "criteriaResults",
    "technicalAccessStatus",
    "customerUseStatus",
    "overallStatus",
    "sla",
    "nextDecision",
    "decisionBasis",
    "closureEligible",
    "nextAction",
    "limitations",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/semanticVersion"
    },
    "recordType": {
      "const": "OUTCOME_VERIFICATION"
    },
    "verificationId": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
    },
    "correlationId": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
    },
    "promiseId": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
    },
    "accountKey": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "syntheticData": {
      "type": "boolean"
    },
    "rulesetVersion": {
      "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/semanticVersion"
    },
    "criteriaResults": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "criterionType",
          "status",
          "method",
          "evidenceRefs",
          "observedAt",
          "verifiedBy",
          "note"
        ],
        "properties": {
          "criterionId": {
            "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
          },
          "criterionType": {
            "type": "string",
            "enum": [
              "SALESFORCE_ACCESS_RESTORED",
              "CUSTOMER_REPORT_ACCESSED",
              "PROMISE_WITHIN_SLA",
              "OTHER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INCONCLUSIVE"
            ]
          },
          "method": {
            "type": "string",
            "enum": [
              "SYSTEM_CHECK",
              "HUMAN_ATTESTATION",
              "DETERMINISTIC_TIME_CALCULATION"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verifiedBy": {
            "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/actor"
          },
          "note": {
            "type": "string",
            "minLength": 3,
            "maxLength": 1000
          }
        }
      }
    },
    "technicalAccessStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "customerUseStatus": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "overallStatus": {
      "type": "string",
      "enum": [
        "ACHIEVED",
        "NOT_ACHIEVED",
        "INCONCLUSIVE"
      ]
    },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dueAt",
        "completionAt",
        "status",
        "calendarId",
        "calculatedBy"
      ],
      "properties": {
        "dueAt": {
          "type": "string",
          "format": "date-time"
        },
        "completionAt": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DELIVERED_WITHIN_SLA",
            "DELIVERED_LATE",
            "BREACHED_OPEN",
            "INCONCLUSIVE"
          ]
        },
        "calendarId": {
          "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
        },
        "calculatedBy": {
          "const": "DETERMINISTIC_RULE_ENGINE"
        }
      }
    },
    "nextDecision": {
      "type": "string",
      "enum": [
        "CLOSE",
        "RETRY",
        "REROUTE",
        "ESCALATE",
        "HUMAN_REVIEW"
      ]
    },
    "decisionBasis": {
      "const": "DETERMINISTIC_RULES"
    },
    "closureEligible": {
      "type": "boolean"
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionCode",
        "ownerRole",
        "reason"
      ],
      "properties": {
        "actionCode": {
          "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/identifier"
        },
        "ownerRole": {
          "type": "string",
          "enum": [
            "CUSTOMER_SUCCESS_MANAGER",
            "SALESFORCE_ADMINISTRATOR",
            "DELIVERY_LEAD",
            "SYSTEM"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.viridianai.in/promiseops/v1.0.0/common.schema.json#/$defs/warning"
      }
    }
  }
}

